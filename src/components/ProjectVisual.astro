---
const { kind = 'slotq' } = Astro.props;

const config = {
  slotq: {
    label: 'SlotQ flow: reservation, waitlist, events, and recovery',
    index: '01 / PRODUCT FLOW',
    nodes: ['RESERVATION', 'WAITLIST', 'EVENT', 'RECOVERY']
  },
  uctale: {
    label: 'UCTale flow: turn, state, memory, and LLM narrative',
    index: '02 / GAME STATE',
    nodes: ['TURN', 'STATE', 'MEMORY', 'LLM']
  },
  fowoco: {
    label: 'FOWOCO data boundary: tenant, RLS, PostgreSQL, and timeout protection',
    index: '03 / DATA BOUNDARY',
    nodes: ['TENANT', 'RLS', 'POSTGRESQL', 'TIMEOUT']
  }
}[kind] ?? {
  label: 'System flow',
  index: 'SYSTEM FLOW',
  nodes: ['INPUT', 'STATE', 'PROCESS', 'OUTPUT']
};
---
<div class:list={['system-visual', kind !== 'slotq' && 'compact', kind === 'fowoco' && 'muted']} role="img" aria-label={config.label}>
  <span class="node node-a">{config.nodes[0]}</span>
  <span class="node node-b">{config.nodes[1]}</span>
  <span class="node node-c">{config.nodes[2]}</span>
  <span class="node node-d">{config.nodes[3]}</span>
  <span class="path path-ab" aria-hidden="true"><span class="signal signal-one"></span></span>
  <span class="path path-ac" aria-hidden="true"><span class="signal signal-two"></span></span>
  <span class="path path-cd" aria-hidden="true"><span class="signal signal-three"></span></span>
  <span class="diagram-cursor" aria-hidden="true"><span class="diagram-cursor-x"></span><span class="diagram-cursor-y"></span></span>
  <span class="diagram-readout mono" data-diagram-readout aria-hidden="true">IDLE / {config.nodes[0]}</span>
  <span class="visual-index" aria-hidden="true">{config.index}</span>
</div>
